
[TextEditor]
custom-font='JetBrainsMono Nerd Font Mono 12'
highlight-current-line=true
restore-session=false
right-margin-position=uint32 75
show-line-numbers=true
show-map=true
spellcheck=false
style-scheme='classic-dark'
use-system-font=false

[desktop/background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/Wallpapers/KQWLP.jpg'
picture-uri-dark='file:///usr/share/backgrounds/Wallpapers/KQWLP.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[desktop/datetime]
automatic-timezone=true

[desktop/input-sources]
sources=[('xkb', 'us')]
xkb-options=['terminate:ctrl_alt_bksp']

[desktop/interface]
accent-color='purple'
clock-format='24h'
clock-show-date=false
clock-show-seconds=true
color-scheme='prefer-dark'
cursor-size=24
cursor-theme='default'
document-font-name='Adwaita Sans 12'
enable-hot-corners=false
font-antialiasing='rgba'
font-hinting='full'
font-name='Adwaita Sans 12'
gtk-theme='adw-gtk3-dark'
icon-theme='Papirus-Dark'
monospace-font-name='JetBrainsMono Nerd Font Mono 12'

[desktop/peripherals/mouse]
accel-profile='flat'
speed=-0.40000000000000013

[desktop/peripherals/touchpad]
accel-profile='flat'
send-events='disabled'
two-finger-scrolling-enabled=true

[desktop/privacy]
recent-files-max-age=30
remove-old-temp-files=true
remove-old-trash-files=true

[desktop/screensaver]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/Wallpapers/KQWLP.jpg'
primary-color='#000000000000'
secondary-color='#000000000000'

[settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/']
email=['Mail']
home=['HomePage']
next=['AudioNext']
play=['AudioPlay']
previous=['AudioPrev']
volume-down=['AudioLowerVolume']
volume-mute=['AudioMute']
volume-up=['AudioRaiseVolume']

[settings-daemon/plugins/media-keys/custom-keybindings/custom0]
binding='<Control>Return'
command='kitty'
name='Terminal'

[settings-daemon/plugins/media-keys/custom-keybindings/custom1]
binding='<Control><Alt>Escape'
command='missioncenter'
name='Task Manager'

[settings-daemon/plugins/power]
sleep-inactive-ac-timeout=7200
sleep-inactive-ac-type='nothing'

[shell/app-switcher]
current-workspace-only=true

[shell/extensions/appindicator]
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0
tray-pos='left'

[shell/extensions/blur-my-shell]
rounded-blur-found=false
settings-version=2

[shell/extensions/blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[shell/extensions/blur-my-shell/dash-to-dock]
blur=true
brightness=0.59999999999999998
sigma=30
static-blur=true
style-dash-to-dock=0

[shell/extensions/blur-my-shell/panel]
brightness=0.59999999999999998
corner-radius=0
sigma=30

[shell/extensions/blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[shell/extensions/vitals]
hide-zeros=true
hot-sensors=['_processor_usage_', '_gpu#1_utilization_', '_memory_allocated_', '__network-tx_max__', '__network-rx_max__']
icon-style=1
memory-measurement=0
position-in-panel=2
show-battery=false
show-fan=false
show-gpu=true
show-storage=false
show-system=false
show-voltage=false
update-time=1
use-higher-precision=true

[shell/keybindings]
screenshot=['<Control>F1']
screenshot-window=['<Control>F3']
show-screen-recording-ui=['<Control>F4']
show-screenshot-ui=['<Control>F2']

[software]
check-timestamp=int64 1781930335
first-run=false
flatpak-purge-timestamp=int64 1781975759

[system/location]
enabled=true

[tweaks]
show-extensions-notice=false
